      "checkConstraints": {
        "exercises_slug_kebab": {
          "name": "exercises_slug_kebab",
          "value": "\"exercises\".\"slug\" <> '' AND \"exercises\".\"slug\" NOT GLOB '*[^a-z0-9-]*'"
        },
        "exercises_equipment": {
          "name": "exercises_equipment",
          "value": "\"exercises\".\"equipment\" IN ('barbell', 'dumbbell', 'machine', 'cable', 'bodyweight')"
        },
        "exercises_muscle_group": {
          "name": "exercises_muscle_group",
          "value": "\"exercises\".\"muscle_group\" IN ('legs', 'chest', 'back', 'shoulders', 'core')"
        },
        "exercises_min_weight": {
          "name": "exercises_min_weight",
          "value": "\"exercises\".\"min_weight_kg\" >= 0"
        },
        "exercises_step": {
          "name": "exercises_step",
          "value": "(\"exercises\".\"equipment\" = 'bodyweight' AND \"exercises\".\"weight_step_kg\" = 0 AND \"exercises\".\"min_weight_kg\" = 0) OR (\"exercises\".\"equipment\" <> 'bodyweight' AND \"exercises\".\"weight_step_kg\" > 0)"
        },
        "exercises_cues_3_lines": {
          "name": "exercises_cues_3_lines",
          "value": "length(\"exercises\".\"cues_uk\") - length(replace(\"exercises\".\"cues_uk\", char(10), '')) = 2 AND instr(\"exercises\".\"cues_uk\", char(10) || char(10)) = 0 AND substr(\"exercises\".\"cues_uk\", 1, 1) <> char(10) AND substr(\"exercises\".\"cues_uk\", -1, 1) <> char(10)"
        }
      }
