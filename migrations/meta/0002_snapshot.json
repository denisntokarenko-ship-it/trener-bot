        "user_profiles_goal_note": {
          "name": "user_profiles_goal_note",
          "value": "\"user_profiles\".\"goal_note\" IS NULL OR length(\"user_profiles\".\"goal_note\") <= 300"
        },
        "user_profiles_level": {
          "name": "user_profiles_level",
          "value": "\"user_profiles\".\"level\" IS NULL OR \"user_profiles\".\"level\" IN ('novice', 'mid', 'adv')"
        },
        "user_profiles_days": {
          "name": "user_profiles_days",
          "value": "\"user_profiles\".\"days_per_week\" IS NULL OR \"user_profiles\".\"days_per_week\" BETWEEN 2 AND 5"
        },
        "user_profiles_session_min": {
          "name": "user_profiles_session_min",
          "value": "\"user_profiles\".\"session_min\" IS NULL OR \"user_profiles\".\"session_min\" IN (30, 45, 60, 90)"
        },
        "user_profiles_place": {
          "name": "user_profiles_place",
          "value": "\"user_profiles\".\"place\" IS NULL OR \"user_profiles\".\"place\" IN ('gym', 'home')"
        },
        "user_profiles_limits": {
          "name": "user_profiles_limits",
          "value": "\"user_profiles\".\"limits\" IS NULL OR \"user_profiles\".\"limits\" = '' OR (\"user_profiles\".\"limits\" NOT LIKE ',%' AND \"user_profiles\".\"limits\" NOT LIKE '%,' AND \"user_profiles\".\"limits\" NOT LIKE '%,,%' AND replace(replace(replace(replace(replace(\"user_profiles\".\"limits\", 'knee', ''), 'back', ''), 'shoulder', ''), 'wrist', ''), ',', '') = '')"
        },
        "user_profiles_limits_note": {
          "name": "user_profiles_limits_note",
          "value": "\"user_profiles\".\"limits_note\" IS NULL OR length(\"user_profiles\".\"limits_note\") <= 300"
        },
        "user_profiles_sex": {
          "name": "user_profiles_sex",
          "value": "\"user_profiles\".\"sex\" IS NULL OR \"user_profiles\".\"sex\" IN ('m', 'f')"
        },
        "user_profiles_birth_year": {
          "name": "user_profiles_birth_year",
          "value": "\"user_profiles\".\"birth_year\" IS NULL OR \"user_profiles\".\"birth_year\" BETWEEN 1930 AND 2020"
        },
        "user_profiles_height": {
          "name": "user_profiles_height",
          "value": "\"user_profiles\".\"height_cm\" IS NULL OR \"user_profiles\".\"height_cm\" BETWEEN 120 AND 230"
        },
        "user_profiles_weight": {
          "name": "user_profiles_weight",
          "value": "\"user_profiles\".\"weight_kg\" IS NULL OR \"user_profiles\".\"weight_kg\" BETWEEN 30 AND 300"
        },
        "user_profiles_meals": {
          "name": "user_profiles_meals",
          "value": "\"user_profiles\".\"meals_per_day\" IS NULL OR \"user_profiles\".\"meals_per_day\" BETWEEN 1 AND 5"
        },
        "user_profiles_diet_note": {
          "name": "user_profiles_diet_note",
          "value": "\"user_profiles\".\"diet_note\" IS NULL OR length(\"user_profiles\".\"diet_note\") <= 300"
        },
        "user_profiles_sleep": {
          "name": "user_profiles_sleep",
          "value": "\"user_profiles\".\"sleep_band\" IS NULL OR \"user_profiles\".\"sleep_band\" IN ('lt6', '6_7', '7_8', '8p')"
