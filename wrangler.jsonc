{
  // Верхній рівень — лише локальна розробка (`wrangler dev`, тести). Деплой — тільки з --env.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trener-local",
  // Акаунт із D1 trener-preview і trener-prod (платний тариф). Не секрет; пришпилено явно, щоб wrangler не вгадував акаунт (В1 R-0).
  "account_id": "3d91f58920a9d270ee8d634d17e164b1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trener-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Блоки env не успадковують bindings і triggers — повторюємо явно.
  "env": {
    "preview": {
      "name": "trener-preview",
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trener-preview",
          "database_id": "f00d635a-d637-4d54-95e3-ee2c26370eba",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "trener-prod",
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trener-prod",
          "database_id": "c34e8f9c-0be8-4125-aabe-840e8ff65bb2",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
