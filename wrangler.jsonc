{
  // Верхній рівень — лише локальна розробка (`wrangler dev`, тести). Деплой — тільки з --env.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trener-local",
  // Акаунт d156e789 (Workers Paid) із D1 trener-preview і trener-prod; перенесено 2026-11-22 з 3d91f589 (Free). Не секрет; пришпилено явно, щоб wrangler не вгадував акаунт (В1 R-0).
  "account_id": "d156e789bad9b2e122115788dc94e006",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  // Версія деплою для /health (v=…); binding не успадковується env-блоками — повторено нижче.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trener-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Блоки env не успадковують bindings і triggers — повторюємо явно.
  "env": {
    "preview": {
      "name": "trener-preview",
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trener-preview",
          "database_id": "44417ee0-ea0b-4f96-9051-a6ffd963b803",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "trener-prod",
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trener-prod",
          "database_id": "cdfc2976-fb96-45ab-b356-a8889d496aa9",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
